# Every directive R recognizes, including the singular S4 aliases.
export(foo, "bar")
exportPattern("^[^.]")
exportClassPattern("^Class")
exportClass(OldClass)
exportClasses(NewClass)
exportMethods(show)
import(stats, utils, except = c(filter, lag))
importFrom(stats, predict)
importClassFrom(methods, oldClass)
importClassesFrom(methods, newClass)
importMethodsFrom(methods, show)
useDynLib(pkg, .registration = TRUE, .fixes = c("C_", "_"))
S3method(stats::predict, thing, predict_thing)
