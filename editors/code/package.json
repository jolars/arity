{
  "name": "arity",
  "displayName": "Arity",
  "description": "R language server, formatter, and linter",
  "version": "0.7.0",
  "publisher": "jolars",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jolars/arity.git"
  },
  "homepage": "https://arity.cc/",
  "bugs": {
    "url": "https://github.com/jolars/arity/issues"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Formatters",
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "r",
    "rlang",
    "formatter",
    "linter",
    "language-server"
  ],
  "activationEvents": [
    "onLanguage:r",
    "workspaceContains:**/*.R",
    "workspaceContains:**/*.r",
    "workspaceContains:**/*.Rproj",
    "workspaceContains:arity.toml",
    "workspaceContains:.arity.toml",
    "workspaceContains:DESCRIPTION"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "r",
        "extensions": [
          ".R",
          ".r",
          ".Rprofile",
          ".rprofile"
        ],
        "aliases": [
          "R",
          "r"
        ],
        "filenames": [
          "NAMESPACE"
        ]
      }
    ],
    "configuration": {
      "title": "Arity",
      "properties": {
        "arity.executableStrategy": {
          "type": "string",
          "enum": [
            "bundled",
            "environment",
            "path"
          ],
          "enumDescriptions": [
            "Use the binary bundled inside the extension; fall back to downloading from GitHub if none is bundled or `arity.version`/`arity.releaseTag` is set explicitly (default).",
            "Look for `arity` on the system PATH.",
            "Use the binary at `arity.executablePath`."
          ],
          "default": "bundled",
          "markdownDescription": "Strategy used to locate the `arity` executable for the language server."
        },
        "arity.executablePath": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "markdownDescription": "Path to the `arity` executable. Only used when `arity.executableStrategy` is set to `path`."
        },
        "arity.version": {
          "type": "string",
          "default": "latest",
          "description": "Arity version to install (for example: latest or 0.2.0)."
        },
        "arity.releaseTag": {
          "type": "string",
          "default": "latest",
          "description": "Advanced override for the exact GitHub release tag (for example: v0.2.0). If explicitly set, this takes precedence over arity.version."
        },
        "arity.githubRepo": {
          "type": "string",
          "default": "jolars/arity",
          "description": "GitHub repository used for Arity binary downloads (<owner>/<repo>)."
        },
        "arity.serverArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional command-line arguments passed after `arity lsp`."
        },
        "arity.serverEnv": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Environment variables merged into the Arity language server process."
        },
        "arity.extraPath": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra PATH entries prepended for the Arity language server process."
        },
        "arity.logLevel": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "off",
            "error",
            "warn",
            "info",
            "debug",
            "trace"
          ],
          "default": null,
          "markdownDescription": "Log level for the Arity language server. Maps to the `RUST_LOG` environment variable. Leave unset to use the server's default. If `arity.serverEnv.RUST_LOG` is also set, it takes precedence."
        },
        "arity.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace communication between VS Code and the Arity language server."
        }
      }
    },
    "configurationDefaults": {
      "[r]": {
        "editor.defaultFormatter": "jolars.arity"
      }
    },
    "commands": [
      {
        "command": "arity.restart",
        "title": "Restart Server",
        "category": "Arity"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run clean && npm run check-types && npm run bundle:prod",
    "compile": "npm run clean && npm run check-types && npm run bundle",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit -p .",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --target=node20 --format=cjs --sourcemap --external:vscode --outfile=dist/extension.js",
    "bundle:prod": "esbuild src/extension.ts --bundle --platform=node --target=node20 --format=cjs --minify --external:vscode --outfile=dist/extension.js",
    "watch": "npm-run-all -p watch:esbuild watch:tsc",
    "watch:esbuild": "esbuild src/extension.ts --bundle --platform=node --target=node20 --format=cjs --sourcemap --watch --external:vscode --outfile=dist/extension.js",
    "watch:tsc": "tsc --noEmit -w -p .",
    "package": "vsce package"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "tar": "^7.5.16",
    "vscode-languageclient": "^10.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^25.9.2",
    "@types/vscode": "^1.91.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3"
  }
}
