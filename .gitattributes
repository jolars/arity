# Let Git auto-detect text files
* text=auto

# R fixtures should use LF by default for consistent snapshots
tests/fixtures/**/*.R eol=lf
crates/*/tests/fixtures/**/*.R eol=lf

# DCF fixtures likewise: the snapshots pin byte offsets, so a normalized
# line ending would shift every range in the tree.
crates/*/tests/fixtures/dcf/**/*.dcf eol=lf

# Oracle corpus + baselines must use LF so format/projector baselines (which
# are blessed on LF) stay byte-identical on every platform, Windows included.
tests/oracle/** eol=lf

# Snapshot files should always use LF
tests/**/snapshots/**/* eol=lf
crates/*/tests/snapshots/**/* eol=lf

# Preserve line ending fixtures as-is (CRLF/LF)
crates/arity-parser/tests/fixtures/parser/crlf_*/* -text
crates/arity-parser/tests/fixtures/parser/lf_*/* -text
crates/arity-parser/tests/fixtures/parser/*_crlf_*/* -text
crates/arity-parser/tests/fixtures/parser/*_lf_*/* -text
crates/arity-parser/tests/fixtures/parser/*_crlf/* -text
crates/arity-parser/tests/fixtures/parser/*_lf/* -text
crates/arity-parser/tests/fixtures/dcf/crlf/* -text
