{
  "$schema": "https://raw.githubusercontent.com/jolars/versionary/main/schemas/config.json",
  "version": 1,
  "release-type": "rust",
  "bump-minor-pre-major": true,
  "include-commit-authors": true,
  "release-reference-comments": "best-effort",
  "packages": {
    ".": {
      "exclude-paths": [
        "editors",
        "crates/arity-parser",
        "crates/arity-formatter"
      ],
      "extra-files": [
        {
          "type": "json",
          "path": "npm/arity-cli/package.json",
          "field-path": "$.version"
        },
        {
          "type": "json",
          "path": "npm/arity-cli/package.json",
          "field-path": "$.optionalDependencies.*"
        }
      ]
    },
    "crates/arity-parser": {},
    "crates/arity-formatter": {},
    "editors/code": {
      "release-type": "node",
      "package-name": "arity-code",
      "follows": ["."]
    },
    // The Zed extension is submitted to `zed-industries/extensions` by hand, so
    // it deliberately does not `follow` the CLI: a release here means a registry
    // pull request, and tying it to every CLI release would leave the registry
    // permanently stale.
    "editors/zed": {
      "package-name": "arity-zed",
      "extra-files": [
        {
          "type": "toml",
          "path": "extension.toml",
          "field-path": "$.version"
        },
        // `Cargo.lock` records the crate's own version, and nothing else keeps
        // it in step with `Cargo.toml`. The `--locked` build in CI is the
        // backstop if this rule ever stops matching.
        {
          "type": "regex",
          "path": "Cargo.lock",
          "pattern": "name = \"zed_arity\"\\nversion = \"([^\"]+)\""
        }
      ]
    }
  }
}
