(\description (TEXT "Inline HTML comment, PI, declaration, and CDATA"))
(\details (TEXT "before") (\if (TEXT "html") (\out (VERB "<!-- hidden -- ok -->"))) (TEXT "after, empty") (\if (TEXT "html") (\out (VERB "<!-->"))) (TEXT "and") (\if (TEXT "html") (\out (VERB "<!--->"))) (TEXT "too pi") (\if (TEXT "html") (\out (VERB "<?php echo x ?>"))) (TEXT "here, empty") (\if (TEXT "html") (\out (VERB "<??>"))) (TEXT "too decl") (\if (TEXT "html") (\out (VERB "<!DOCTYPE html>"))) (TEXT "and single-letter") (\if (TEXT "html") (\out (VERB "<!D x>"))) (TEXT "here cdata") (\if (TEXT "html") (\out (VERB "<![CDATA[raw <b> ]] text]]>"))) (TEXT "and lowercase") (\if (TEXT "html") (\out (VERB "<![cdata[y]]>"))) (TEXT "here not a comment: a <!-- dashy ---> b, unterminated <!-- x -- > c not a declaration: <!doctype html> and <!DOCTYPE> stay literal"))
(\title (TEXT "Inline HTML comment, PI, declaration, and CDATA"))
