(\description (TEXT "Block macro bodies with markdown off"))
(\description (TEXT "Markdown blocks inside a block macro body"))
(\details (TEXT "A markdown block construct inside a block Rd macro's body is a block, not prose: cmark sees the whole field flat, so the") (\verb (VERB "\\describe{")) (TEXT "/") (\verb (VERB "\\item{")) (TEXT "lines are ordinary paragraph text and a list at the same column opens a real list.") (\describe (\item (TEXT "term") (GRP (TEXT "a definition, then a list") (\itemize (\item) (TEXT "one") (\item) (TEXT "two")))) (\item (TEXT "plain") (TEXT "no block here"))) (TEXT "A list may also interrupt the definition's paragraph with no blank line:") (\describe (\item (TEXT "lazy") (GRP (TEXT "intro") (\itemize (\item) (TEXT "alpha") (\item) (TEXT "beta"))))) (TEXT "An item whose body is only a list takes no") (\code (RCODE "GRP")) (TEXT "wrapper:") (\describe (\item (TEXT "bare") (\itemize (\item) (TEXT "solo")))) (TEXT "A fenced code block folds in the same way:") (\describe (\item (TEXT "code") (GRP (TEXT "leading prose") (\if (TEXT "html") (\out (VERB "<div class=\"sourceCode\">"))) (\preformatted (VERB "mean(x)\n")) (\if (TEXT "html") (\out (VERB "</div>")))))) (TEXT "An ordered list inside an") (\verb (VERB "\\itemize")) (TEXT "body, terminated by a blank line:") (\itemize (\item) (TEXT "first") (\enumerate (\item) (TEXT "a") (\item) (TEXT "b"))))
(\details (TEXT "With markdown off the same text is literal Rd prose: a dash opens no list and a fence is not a code block, so the definition stays one text run.") (\describe (\item (TEXT "term") (TEXT "a definition, then what looks like a list - one - two"))))
(\title (TEXT "Block macro bodies with markdown off"))
(\title (TEXT "Markdown blocks inside a block macro body"))
