(\description (TEXT "Zero-arity R system Rd user macros"))
(\description (TEXT "Zero-arity user macros under markdown"))
(\details (TEXT "The expansion is plain Rd in both modes:") (USERMACRO "\\ifelse{latex}{\\out{{\\LaTeX}}}{LaTeX}") (\ifelse (TEXT "latex") (\out (VERB "{\\LaTeX}")) (TEXT "LaTeX")) (LIST) (TEXT "and") (USERMACRO "\\ifelse{latex}{\\out{~}}{ }") (\ifelse (TEXT "latex") (\out (VERB "~"))) (LIST) (TEXT "still expand, and") (\emph (TEXT "emphasis")) (TEXT "around") (USERMACRO "\\ifelse{latex}{\\out{{\\LaTeX}}}{LaTeX}") (\ifelse (TEXT "latex") (\out (VERB "{\\LaTeX}")) (TEXT "LaTeX")) (TEXT "still resolves."))
(\details (TEXT "The macros") (USERMACRO "\\ifelse{latex}{\\out{~}}{ }") (\ifelse (TEXT "latex") (\out (VERB "~"))) (TEXT "and") (USERMACRO "\\ifelse{latex}{\\out{{\\LaTeX}}}{LaTeX}") (\ifelse (TEXT "latex") (\out (VERB "{\\LaTeX}")) (TEXT "LaTeX")) (TEXT "are defined with no placeholder, so parse_Rd expands them on the name alone and never consumes a following group. A period.") (USERMACRO "\\ifelse{latex}{\\out{~}}{ }") (\ifelse (TEXT "latex") (\out (VERB "~"))) (LIST) (TEXT "Then") (USERMACRO "\\ifelse{latex}{\\out{{\\LaTeX}}}{LaTeX}") (\ifelse (TEXT "latex") (\out (VERB "{\\LaTeX}")) (TEXT "LaTeX")) (LIST) (TEXT "typesetting. A written group is a sibling list, not an argument:") (USERMACRO "\\ifelse{latex}{\\out{~}}{ }") (\ifelse (TEXT "latex") (\out (VERB "~"))) (LIST (TEXT "x")) (TEXT "and") (USERMACRO "\\ifelse{latex}{\\out{{\\LaTeX}}}{LaTeX}") (\ifelse (TEXT "latex") (\out (VERB "{\\LaTeX}")) (TEXT "LaTeX")) (LIST (TEXT "y")) (TEXT "both leave their braces behind. They expand wherever they sit:") (\emph (USERMACRO "\\ifelse{latex}{\\out{{\\LaTeX}}}{LaTeX}") (\ifelse (TEXT "latex") (\out (VERB "{\\LaTeX}")) (TEXT "LaTeX")) (LIST) (TEXT "in emphasis")) (TEXT "and") (\code (USERMACRO "\\ifelse{latex}{\\out{~}}{ }") (\ifelse (TEXT "latex") (\out (VERB "~"))) (RCODE "{}")) (TEXT "in code."))
(\references (TEXT "Typeset with") (USERMACRO "\\ifelse{latex}{\\out{{\\LaTeX}}}{LaTeX}") (\ifelse (TEXT "latex") (\out (VERB "{\\LaTeX}")) (TEXT "LaTeX")) (TEXT "."))
(\title (TEXT "Zero-arity R system Rd user macros"))
(\title (TEXT "Zero-arity user macros under markdown"))
