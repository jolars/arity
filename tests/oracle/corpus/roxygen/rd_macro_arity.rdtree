(\description (TEXT "Arity under markdown"))
(\description (TEXT "Block-form multi-argument macros"))
(\description (TEXT "Multi-argument system user macros"))
(\description (TEXT "Per-macro Rd argument arity"))
(\details (TEXT "A fragile multi-argument macro keeps every argument literal:") (\ifelse (TEXT "html") (TEXT "*yes*") (TEXT "*no*")) (TEXT "and") (\method (TEXT "print") (TEXT "*foo*")) (TEXT ". A non-fragile one has each argument markdown-processed:") (\subsection (GRP (TEXT "A") (\emph (TEXT "title"))) (GRP (TEXT "a") (\strong (TEXT "body")) (TEXT "with") (\code (RCODE "code")))) (TEXT "and") (\enc (\emph (TEXT "a")) (\emph (TEXT "b"))) (TEXT "."))
(\details (TEXT "Now that three-argument macros parse, the system macros that expand through a conditional work: a language name") (USERMACRO "\\ifelse{latex}{\\out{\\textsf{#1}}}{#1}C++") (\ifelse (TEXT "latex") (\out (VERB "\\textsf{C++}")) (TEXT "C++")) (TEXT "in prose. A manual citation") (USERMACRO "\\Sexpr[results=rd]{tools:::Rd_expr_manual(\"#1\", \"#2\")}R-extsWriting R Extensions") (\Sexpr (RCODE "tools:::Rd_expr_manual(\"R-exts\", \"Writing R Extensions\")")) (TEXT "takes two arguments, and") (USERMACRO "\\Sexpr[stage=build]{tools:::Rd_expr_bibinfo(\"#1\", \"#2\", r\"(#3)\")}authorSmithextra") (\Sexpr (RCODE "tools:::Rd_expr_bibinfo(\"author\", \"Smith\", r\"(extra)\")")) (TEXT "takes three. They expand nested as well:") (\emph (USERMACRO "\\ifelse{latex}{\\out{\\textsf{#1}}}{#1}Rust") (\ifelse (TEXT "latex") (\out (VERB "\\textsf{Rust}")) (TEXT "Rust"))) (TEXT "and") (\code (USERMACRO "\\Sexpr[results=rd]{tools:::Rd_expr_manual(\"#1\", \"#2\")}R-langR Language Definition") (\Sexpr (RCODE "tools:::Rd_expr_manual(\"R-lang\", \"R Language Definition\")"))) (TEXT "."))
(\details (TEXT "parse_Rd gives each Rd macro its own argument count, so") (\ifelse (TEXT "html") (TEXT "yes") (TEXT "no")) (TEXT "consumes three groups while a one-argument macro leaves the rest as prose. An argument with several atoms wraps:") (\ifelse (TEXT "html") (GRP (TEXT "yes") (\emph (TEXT "em")) (TEXT "branch")) (TEXT "plain no")) (TEXT ". A fourth group is not an argument:") (\ifelse (TEXT "a") (TEXT "b") (TEXT "c")) (LIST (TEXT "d")) (TEXT "ends the call. The two-argument conditionals and dispatch forms behave the same way:") (\if (TEXT "latex") (TEXT "only in LaTeX")) (TEXT ",") (\method (TEXT "print") (TEXT "foo")) (TEXT ",") (\S3method (TEXT "format") (TEXT "bar")) (TEXT ", and") (\S4method (TEXT "show") (TEXT "baz")) (TEXT ". Encoding fallbacks take two groups too:") (\enc (TEXT "Jöreskog") (TEXT "Joreskog")) (TEXT ". A single-line") (\subsection (TEXT "Inline heading") (TEXT "with a body")) (TEXT "nests in place."))
(\details (\subsection (TEXT "Spanning heading") (GRP (TEXT "The body of a two-argument macro may span lines, exactly as a") (\code (\link (TEXT "describe"))) (TEXT "definition does."))) (\ifelse (TEXT "html") (TEXT "The html branch spans lines.") (TEXT "The fallback branch does too.")))
(\title (TEXT "Arity under markdown"))
