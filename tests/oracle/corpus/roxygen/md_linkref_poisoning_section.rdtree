(\description (TEXT "Link-reference poisoning inside a section body"))
(\section (TEXT "My heading") (GRP (TEXT "A shortcut like") (\link (TEXT "before")) (TEXT "resolves, but an escaped-close candidate like [stop] poisons the appended definition block, so a later [after] shortcut is de-linked and both tail definitions leak after the colon. [stop]: R:stop%5C [after]: R:after")))
(\title (TEXT "Link-reference poisoning inside a section body"))
