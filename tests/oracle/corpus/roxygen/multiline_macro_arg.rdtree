(\description (TEXT "Multi-line Rd macro arguments"))
(\details (TEXT "A two-argument macro's last argument may span `#'` lines, so the whole call is a block macro even though its earlier groups closed on the opening line.") (\describe (\item (TEXT "a") (TEXT "a definition long enough that it continues onto a second line")) (\item (TEXT "b") (GRP (TEXT "a definition with a") (\code (RCODE "nested")) (TEXT "inline macro and a bare {group} across lines"))) (\item (\code (RCODE "term")) (TEXT "a nested macro in the term argument, whose definition also spans lines")) (\item (TEXT "c") (TEXT "one line")) (TEXT "and trailing prose") (\item (TEXT "d") (TEXT "a definition that closes here")) (\item (TEXT "e") (TEXT "and another follows"))) (TEXT "A link display can also span lines:") (\href (VERB "http://example.org") (TEXT "the example site")) (TEXT "sits mid-prose.") (\tabular (TEXT "ll") (GRP (TEXT "a") (\tab) (TEXT "b") (\cr))))
(\title (TEXT "Multi-line Rd macro arguments"))
