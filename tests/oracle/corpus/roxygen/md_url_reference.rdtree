(\description (TEXT "URL-defined reference links"))
(\details (TEXT "A reference with a user definition links to that URL, keeping its display: see") (\href (VERB "https://example.com") (\emph (TEXT "foo"))) (TEXT ",") (\href (VERB "https://example.org") (TEXT "plain")) (TEXT ", and the bare shortcut") (\href (VERB "https://example.net") (TEXT "r3")) (TEXT ". The definition lines below are consumed by cmark and render nothing."))
(\title (TEXT "URL-defined reference links"))
