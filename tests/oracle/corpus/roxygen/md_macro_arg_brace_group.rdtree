(\description (TEXT "Bare brace groups inside a macro arg under md"))
(\details (TEXT "A latexlike arg groups:") (\emph (TEXT "a") (LIST (TEXT "b")) (TEXT "c")) (TEXT ". Groups nest:") (\strong (TEXT "d") (LIST (TEXT "e") (LIST (TEXT "f")) (TEXT "g")) (TEXT "h")) (TEXT ". A group spans a macro:") (\emph (TEXT "i") (LIST (TEXT "j") (\strong (TEXT "k")) (TEXT "l")) (TEXT "m")) (TEXT ". An empty group is a list:") (\emph (TEXT "n") (LIST) (TEXT "o")) (TEXT ". A structural display GRP-wraps:") (\href (VERB "http://x.org") (GRP (TEXT "s") (LIST (TEXT "t")) (TEXT "u"))) (TEXT ". A verbatim arg never groups:") (\code (RCODE "v {w} x")) (TEXT "."))
(\title (TEXT "Bare brace groups inside a macro arg under md"))
