(\author (TEXT "An unknown name is a node: u") (UNKNOWN "\\zzz") (TEXT "v w."))
(\description (TEXT "Brace-less system Rd user macros in prose"))
(\description (TEXT "Brace-less system macros under markdown"))
(\details (TEXT "A one-argument system macro swallows its tail: before") (VERB " b after.\n"))
(\details (TEXT "Markdown mode swallows too: before") (VERB " b after.\n"))
(\note (TEXT "A two-argument one as well: x") (VERB " y z.\n"))
(\note (TEXT "A written group still binds: see") (USERMACRO "\\Sexpr[results=rd]{tools:::Rd_expr_doi(\"#1\")}10.1/x") (\Sexpr (RCODE "tools:::Rd_expr_doi(\"10.1/x\")")) (TEXT "here."))
(\references (TEXT "A zero-arity one expands instead: r") (USERMACRO "\\ifelse{latex}{\\out{~}}{ }") (\ifelse (TEXT "latex") (\out (VERB "~"))) (TEXT "s t."))
(\seealso (TEXT "An identity macro does too: a") (VERB " b c.\n"))
(\seealso (TEXT "Wrapped under markdown: p") (VERB " q\n") (VERB "and a continued line.\n"))
(\source (TEXT "Soft-wrapped past the trigger: p") (VERB " q\n") (VERB "  and a continued line.\n"))
(\title (TEXT "Brace-less system Rd user macros in prose"))
(\title (TEXT "Brace-less system macros under markdown"))
