(\description (TEXT "Unknown Rd macros under markdown"))
(\description (TEXT "parse_Rd tags an unrecognized") (UNKNOWN "\\zzz") (TEXT "UNKNOWN and consumes nothing for it, so a written group is a following sibling brace list."))
(\details (TEXT "One group:") (UNKNOWN "\\zzz") (LIST (TEXT "x")) (TEXT "stays a sibling. Two groups:") (UNKNOWN "\\zzz") (LIST (TEXT "x")) (LIST (TEXT "y")) (TEXT "are two siblings. An empty one still counts:") (UNKNOWN "\\zzz") (LIST) (TEXT "here. The optional-argument bracket is literal too:") (UNKNOWN "\\zzz") (TEXT "[a]") (LIST (TEXT "x")) (TEXT "and a bracket with no group at all,") (UNKNOWN "\\zzz") (TEXT "[a] here. Nested in a macro argument:") (\emph (UNKNOWN "\\zzz") (LIST (TEXT "x")) (TEXT "inside")) (TEXT "and in R code,") (\code (UNKNOWN "\\zzz") (RCODE "{x}")) (TEXT "keeps its braces verbatim. A group may span lines:") (UNKNOWN "\\zzz") (LIST (TEXT "spanning")) (TEXT "A defined system user macro is the contrast ---") (USERMACRO "\\href{https://CRAN.R-project.org/package=#1}{\\pkg{#1}}utils") (\href (VERB "https://CRAN.R-project.org/package=utils") (\pkg (TEXT "utils"))) (TEXT "does consume its argument, and so does the two-argument") (USERMACRO "\\Sexpr[results=rd]{tools:::Rd_expr_manual(\"#1\", \"#2\")}ab") (\Sexpr (RCODE "tools:::Rd_expr_manual(\"a\", \"b\")")) (TEXT "."))
(\details (TEXT "The rule is mode-independent:") (UNKNOWN "\\zzz") (LIST (\emph (TEXT "x"))) (TEXT "leaves the group behind (its markdown still resolves), and a brace-less") (UNKNOWN "\\zzz") (TEXT "is the same UNKNOWN node."))
(\title (TEXT "Unknown Rd macros never consume a group"))
(\title (TEXT "Unknown Rd macros under markdown"))
