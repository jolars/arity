(\description (TEXT "A leading tab expands to the next 4-column stop, so a tab line is indented code; interior tabs stay verbatim in the code body."))
(\details (\if (TEXT "html") (\out (VERB "<div class=\"sourceCode\">"))) (\preformatted (VERB "foo	baz		bim\n") (VERB "next\n") (VERB "bar\n")) (\if (TEXT "html") (\out (VERB "</div>"))))
(\title (TEXT "Tab-stop expansion reaches CommonMark's indented-code threshold"))
