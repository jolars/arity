(\description (TEXT "R system Rd user macros"))
(\description (TEXT "User macros under markdown"))
(\details (TEXT "A user macro's argument is protected from cmark, so") (\verb (VERB "*b*")) (TEXT "stays literal:") (USERMACRO "\\href{https://CRAN.R-project.org/package=#1}{\\pkg{#1}}a *b* c") (\href (VERB "https://CRAN.R-project.org/package=a *b* c") (\pkg (TEXT "a *b* c"))) (TEXT ". The macro still expands:") (USERMACRO "\\Sexpr[results=rd]{tools:::Rd_expr_doi(\"#1\")}10.1/2") (\Sexpr (RCODE "tools:::Rd_expr_doi(\"10.1/2\")")) (TEXT "."))
(\details (TEXT "R loads `share/Rd/macros/system.Rd` before every Rd file, so parse_Rd expands these into a `USERMACRO` node carrying the raw definition plus the argument text, immediately followed by the expansion itself. A DOI") (USERMACRO "\\Sexpr[results=rd]{tools:::Rd_expr_doi(\"#1\")}10.1000/182") (\Sexpr (RCODE "tools:::Rd_expr_doi(\"10.1000/182\")")) (TEXT ", a CRAN package") (USERMACRO "\\href{https://CRAN.R-project.org/package=#1}{\\pkg{#1}}dplyr") (\href (VERB "https://CRAN.R-project.org/package=dplyr") (\pkg (TEXT "dplyr"))) (TEXT ", and a bug report") (USERMACRO "\\Sexpr[results=rd]{tools:::Rd_expr_PR(#1)}1234") (\Sexpr (RCODE "tools:::Rd_expr_PR(1234)")) (TEXT "each expand in prose. The identity macro") (USERMACRO "#1stays put") (TEXT "stays put expands to its argument, which then coalesces with the surrounding prose. The build-stage variants expand the same way:") (USERMACRO "\\Sexpr[results=rd,stage=build]{tools:::Rd_package_title(\"#1\")}stats") (\Sexpr (RCODE "tools:::Rd_package_title(\"stats\")")) (TEXT "and") (USERMACRO "\\Sexpr[results=rd,stage=build]{tools:::Rd_package_description(\"#1\")}stats") (\Sexpr (RCODE "tools:::Rd_package_description(\"stats\")")) (TEXT ", as does a bibentry citation") (USERMACRO "\\Sexpr[results=rd,stage=build]{tools:::Rd_expr_bibcite(r\"(#1)\", FALSE)}key") (\Sexpr (RCODE "tools:::Rd_expr_bibcite(r\"(key)\", FALSE)")) (TEXT ". Expansion happens wherever the macro sits: nested in") (\emph (USERMACRO "\\Sexpr[results=rd]{tools:::Rd_expr_doi(\"#1\")}10.1/2") (\Sexpr (RCODE "tools:::Rd_expr_doi(\"10.1/2\")"))) (TEXT "and in") (\code (USERMACRO "\\href{https://CRAN.R-project.org/package=#1}{\\pkg{#1}}utils") (\href (VERB "https://CRAN.R-project.org/package=utils") (\pkg (TEXT "utils")))) (TEXT "."))
(\references (TEXT "A paper with a DOI,") (USERMACRO "\\Sexpr[results=rd]{tools:::Rd_expr_doi(\"#1\")}10.1000/182") (\Sexpr (RCODE "tools:::Rd_expr_doi(\"10.1000/182\")")) (TEXT "."))
(\title (TEXT "R system Rd user macros"))
(\title (TEXT "User macros under markdown"))
