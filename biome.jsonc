{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  // Biome checks the VS Code extension and npm launcher shim. Documentation
  // scripts and styles use Prettier; generated JSON stays generator-owned.
  "files": {
    "includes": ["editors/code/src/**/*.ts", "npm/**/*.js", "!**/node_modules"]
  },
  // Match the style the sources are already written in, so adopting biome is
  // not a repo-wide reformat.
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  }
}
